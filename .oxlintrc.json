{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error"
	},
	"env": {
		"builtin": true
	},
	"ignorePatterns": ["**/dist/**", "node_modules/**", "runtime/target/**"],
	"options": {
		"typeAware": true,
		"denyWarnings": true
	}
}
